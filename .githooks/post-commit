#!/bin/sh
# Packages the committed extension and installs it into VS Code.
# Turn on once per clone: git config core.hooksPath .githooks
set -e

if ! command -v code >/dev/null 2>&1; then
  echo "post-commit: no 'code' CLI on PATH; skipping the install." >&2
  exit 0
fi

version=$(node -p "require('./package.json').version")
vsix="cluster-tunnel-$version.vsix"

npx vsce package --out "$vsix" >/dev/null
# --force reinstalls even when the version number has not changed.
code --install-extension "$vsix" --force
echo "post-commit: installed $vsix; reload VS Code windows to use it."
