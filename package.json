{
  "name": "cluster-tunnel",
  "displayName": "Cluster Tunnel",
  "description": "Shows your HPC clusters and Slurm jobs through the ctun CLI.",
  "version": "0.1.0",
  "publisher": "aimat-lab",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimat-lab/cluster-tunnel-vscode.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ctun",
          "title": "Clusters",
          "icon": "media/clusters.svg"
        }
      ]
    },
    "views": {
      "ctun": [
        {
          "id": "ctun.clusters",
          "name": "Clusters"
        },
        {
          "id": "ctun.projects",
          "name": "Projects"
        },
        {
          "id": "ctun.setup",
          "name": "Setup"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ctun.clusters",
        "contents": "Your ctun clusters will show here."
      }
    ],
    "commands": [
      {
        "command": "ctun.refresh",
        "title": "Refresh",
        "category": "ctun",
        "icon": "$(refresh)"
      },
      {
        "command": "ctun.showJobs",
        "title": "Show Cluster Jobs",
        "category": "ctun",
        "icon": "$(table)"
      },
      {
        "command": "ctun.showCommands",
        "title": "Show Commands Sent",
        "category": "ctun",
        "icon": "$(terminal)"
      },
      {
        "command": "ctun.showReviews",
        "title": "Review Agent Notes",
        "category": "ctun",
        "icon": "$(comment-unresolved)"
      },
      {
        "command": "ctun.hideProject",
        "title": "Hide Project",
        "category": "ctun",
        "icon": "$(eye)"
      },
      {
        "command": "ctun.showProject",
        "title": "Show Project",
        "category": "ctun",
        "icon": "$(eye-closed)"
      },
      {
        "command": "ctun.showAllProjects",
        "title": "Show All Projects",
        "category": "ctun"
      },
      {
        "command": "ctun.showOnlyProject",
        "title": "Show Only This Project",
        "category": "ctun"
      },
      {
        "command": "ctun.installSkill",
        "title": "Install the Claude Code Skill",
        "category": "ctun"
      },
      {
        "command": "ctun.addons.wandb.enable",
        "title": "Turn On the W&B Add-on",
        "category": "ctun"
      },
      {
        "command": "ctun.setWandbKey",
        "title": "Set W&B API Key",
        "category": "ctun"
      },
      {
        "command": "ctun.clearWandbKey",
        "title": "Remove W&B API Key",
        "category": "ctun"
      },
      {
        "command": "ctun.showWandbGuide",
        "title": "How to Tag W&B Runs",
        "category": "ctun"
      },
      {
        "command": "ctun.openConfig",
        "title": "Open ctun Config",
        "category": "ctun",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ctun.login",
        "title": "Log in",
        "category": "ctun",
        "icon": "$(sign-in)"
      },
      {
        "command": "ctun.logout",
        "title": "Log out",
        "category": "ctun",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ctun.showJobs",
          "when": "view == ctun.clusters",
          "group": "navigation@0"
        },
        {
          "command": "ctun.refresh",
          "when": "view == ctun.clusters",
          "group": "navigation@1"
        },
        {
          "command": "ctun.openConfig",
          "when": "view == ctun.clusters",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ctun.login",
          "when": "view == ctun.clusters && viewItem == cluster-down",
          "group": "inline"
        },
        {
          "command": "ctun.logout",
          "when": "view == ctun.clusters && viewItem == cluster-live",
          "group": "inline"
        },
        {
          "command": "ctun.hideProject",
          "when": "view == ctun.projects && viewItem == project-shown",
          "group": "inline"
        },
        {
          "command": "ctun.showProject",
          "when": "view == ctun.projects && viewItem == project-hidden",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "ctun.login",
          "when": "false"
        },
        {
          "command": "ctun.logout",
          "when": "false"
        },
        {
          "command": "ctun.hideProject",
          "when": "false"
        },
        {
          "command": "ctun.showProject",
          "when": "false"
        },
        {
          "command": "ctun.showOnlyProject",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ctun",
      "properties": {
        "ctun.path": {
          "type": "string",
          "default": "ctun",
          "markdownDescription": "Path to the `ctun` executable. The default finds `ctun` on `PATH`."
        },
        "ctun.login.method": {
          "type": "string",
          "enum": [
            "window",
            "vscode"
          ],
          "default": "vscode",
          "enumDescriptions": [
            "ctun's own login window (tkinter).",
            "VS Code input boxes; the secrets reach ctun on stdin only."
          ],
          "markdownDescription": "How **Log in** asks for the session budget, password and OTP. Also applies to `ctun login -i` run by agents and terminals of this window."
        },
        "ctun.addons.wandb.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Turn on the W&B add-on: a Training line with the metrics of the job's W&B run. Runs are found by their tag `slurm:<ClusterName>:<job id>` or `slurm:<job id>`."
        },
        "ctun.addons.wandb.entity": {
          "type": "string",
          "default": "",
          "markdownDescription": "W&B user or team whose projects are searched for tagged runs (the first 100). Empty means the API key's own entity."
        },
        "ctun.addons.wandb.metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "val/loss",
            "val/mae_T_trans"
          ],
          "markdownDescription": "Summary metrics shown for a job's W&B run."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "test:host": "npm run compile && node out/test/host/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3"
  }
}
